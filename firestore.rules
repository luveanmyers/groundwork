rules_version = '2';

// firestore.rules - who may read and write SetOut's shared trip data
// --------------------------------------------------------------------
// SetOut has no server of its own. The app talks straight to Firestore
// from the browser, and the Firebase web config that lets it do that is
// public (it's in this public repo on purpose). So these rules are the
// ONLY thing standing between a trip and the rest of the internet.
// Treat every change to this file like a code change: branch, review,
// "ship it", then publish the same text to BOTH Firebase projects
// (setout-dev and setout) in the console under Firestore -> Rules.
//
// Data shape (see the Linear doc "SetOut - Sync Design"):
//   trips/{tripId}                 trip fields + memberEmails + createdBy
//   trips/{tripId}/ideas/{id}      one document per idea card
//   trips/{tripId}/packing/{id}    one per packing item
//   trips/{tripId}/budget/{id}     one per budget entry
//   trips/{tripId}/notes/{id}      one per note
//
// The rule in one sentence: you can touch a trip, and everything inside
// it, only if you're signed in with a VERIFIED email that's on that
// trip's memberEmails list. Emails are stored lowercase, so the check
// lowercases the signed-in email too.
//
// (rules_version has to be the very first line of the file, before
// any comment, or the console rejects it.)

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, AND the email has been verified. Verification matters:
    // without it, anyone could create an account using Dave's address
    // before Dave does, and inherit his access to every shared trip.
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Is the signed-in person on this trip's member list? Used for the
    // cards, packing, budget and notes inside a trip, which don't carry
    // their own member list - they inherit the trip's.
    function isMemberOfTrip(tripId) {
      return isVerified()
        && myEmail() in get(/databases/$(database)/documents/trips/$(tripId)).data.memberEmails;
    }

    match /trips/{tripId} {
      // Read: members only. The app finds "my trips" with a query
      // (memberEmails array-contains my email), which these rules allow
      // because every trip that query returns has me on its list.
      allow read: if isVerified() && myEmail() in resource.data.memberEmails;

      // Create: you must put yourself on the member list and record
      // yourself as the creator, so nobody can create a trip that
      // claims to belong to someone else.
      allow create: if isVerified()
        && myEmail() in request.resource.data.memberEmails
        && request.resource.data.createdBy == request.auth.uid;

      // Update: any member can edit the trip, including sharing it with
      // someone else (adding an email). Two guard rails: the creator
      // can't be changed, and the member list can never end up empty,
      // which would lock everyone out of the trip for good.
      allow update: if isVerified()
        && myEmail() in resource.data.memberEmails
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberEmails.size() > 0;

      // Delete: any member. (The app deletes the trip's cards and lists
      // first, because Firestore doesn't delete subcollections for you.)
      allow delete: if isVerified() && myEmail() in resource.data.memberEmails;

      // Everything inside a trip, limited to the four known lists so a
      // bug can't quietly start writing data somewhere unexpected.
      match /{list}/{docId} {
        allow read, write: if list in ['ideas', 'packing', 'budget', 'notes']
          && isMemberOfTrip(tripId);
      }
    }

    // Anything not matched above is denied by default. Firestore rules
    // only ever ALLOW; there's no way to reach data no rule allows.
  }
}
